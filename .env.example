# Supabase project settings — Project Settings -> API in your Supabase dashboard.
# Leave these unset during local development and the site will run on the
# built-in demo catalog (lib/data/seed-data.ts) automatically.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, never exposed to the browser. Required for
# order creation/lookup (checkout, track order). Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=
